# ---------------------------------------------------------------------------
# chatAI UI configuration: the single place for every URL the UI uses.
# Override per machine in .env.local (git-ignored), or per environment in
# .env.development / .env.production. Values are baked in at build time.
# ---------------------------------------------------------------------------

# true  = every API call is answered by the in-browser MSW mocks (no backend needed)
# false = calls go to VITE_API_BASE_URL
VITE_USE_MOCKS=true

# Base URL of the chatAI REST API. Every endpoint path below is appended to it.
#   Relative (recommended): same origin as the UI; in dev the Vite server proxies it
#     to VITE_BACKEND_URL, in AWS CloudFront routes it to the ALB.
#   Absolute: e.g. https://chatai-api.example.com/api/v1 (backend must allow CORS).
VITE_API_BASE_URL=/api/v1

# REST endpoint paths, appended to VITE_API_BASE_URL. {placeholders} are filled in
# at call time with URL-encoded values; keep the placeholder names as they are.
VITE_API_ENTITLEMENTS_PATH=/me/entitlements
VITE_API_CONVERSATIONS_PATH=/clients/{clientId}/products/{productId}/conversations
VITE_API_CONVERSATION_PATH=/clients/{clientId}/products/{productId}/conversations/{conversationId}
VITE_API_MESSAGES_PATH=/clients/{clientId}/products/{productId}/conversations/{conversationId}/messages

# Dev server only: where the proxy sends a relative VITE_API_BASE_URL (Spring Boot backend).
VITE_BACKEND_URL=http://localhost:8080

# Dev server only: port for `npm run dev`.
VITE_DEV_PORT=5173
